# --- חובה ---
# הסיסמה לאיזור הניהול (/admin). בחרו סיסמה ארוכה.
ADMIN_PASSWORD=change-me-to-a-long-password
# מחרוזת סודית אקראית לחתימת ההתחברות (לפחות 32 תווים)
JWT_SECRET=replace-with-a-long-random-string

# --- אופציונלי ---
PORT=3001
# תיקיית הנתונים (קובץ ה-DB והתמונות). בשרת ענן יש להפנות לדיסק קבוע.
DATA_DIR=./data

# שליחת מייל על כל פנייה חדשה מהאתר (אם לא מוגדר, הפניות נשמרות רק באיזור הניהול)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=

# --- ענן (Vercel) ---
# נוספים אוטומטית כשמחברים Blob ו-Upstash Redis בלשונית Storage. מקומית אפשר להשאיר ריק.
# BLOB_READ_WRITE_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
